# >>> Environment variables >>>
# omz
export ZSH="$HOME/.oh-my-zsh"
[ -f "/Users/gefan/.local/bin/env" ] && . "/Users/gefan/.local/bin/env"
# local bin
export PATH="$HOME/.local/bin:$PATH"
# docker
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1
# <<< Environment variables <<<

# >>> Oh-my-zsh configs >>>
ZSH_THEME=""
plugins=(
    zsh-autosuggestions
    zsh-syntax-highlighting
)
source $ZSH/oh-my-zsh.sh
# <<< Oh-my-zsh config <<<

# >>> Aliases >>>
# bat
alias cat="bat"
# lsd
alias ls="lsd"
alias ll="lsd -l"
alias la="lsd -a"
alias lla="lsd -la"
alias lt="lsd --tree"
# nano (homebrew)
alias nano="$(brew --prefix)/bin/nano"
# lazygit
alias lg="lazygit"
# ghostty ssh
# alias ssh="ghostty +ssh --"
# <<< Aliases <<<

# >>> Starship init >>>
eval "$(starship init zsh)"
# <<< Starship init <<<

# >>> uv >>>
eval "$(uv generate-shell-completion zsh)"
# <<< uv <<<

# >>> rsync (homebrew) >>>
export PATH="$(brew --prefix rsync)/bin:$PATH"
# <<< rsync (homebrew) <<<

